{
  "name": "brekkie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
