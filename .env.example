# Neon connection string (Project > Connect > pooled connection). Leave empty to use a local embedded Postgres for development.
DATABASE_URL=
PORT=3001
# Show the demo sign-in picker and auto-seed fake data into an empty database. Set to false in production.
DEMO_MODE=true
# First run only: the code whoever sets up the club must enter to become the VPE. Choose a long random phrase.
SETUP_CODE=
# The public address of the deployed app, so QR codes on the agenda point at it, e.g. https://brekkie-zeta.vercel.app
PUBLIC_URL=
